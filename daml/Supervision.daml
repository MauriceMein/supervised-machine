-- The Supervised Machine: a local model of professional-party delegation.
-- Human identity, licensing, model execution and settlement are not verified.
-- Reference sketch for research purposes. Synthetic data only. Not legal advice.
module Supervision where

-- Allowed action labels for creating draft records through the mandate.
data ActionKind
  = DraftDocument
  | SummarizeRecords
  | SendClientUpdate
  deriving (Eq, Show)

-- Step 1: the professional party offers a mandate. The client must accept.
template MandateProposal
  with
    professional : Party   -- professional party; license verification is external
    client       : Party
    agent        : Party   -- the AI agent's party
    matterHash   : Text    -- caller-supplied reference; never submit confidential content
    allowed      : [ActionKind]
    feeCapCents  : Int     -- total the agent may spend on approved fees
    payees       : [Party] -- the only parties the agent may pay
    reviewRecipients : [Party] -- client-approved receipt recipients
    expires      : Time
  where
    signatory professional
    observer client
    ensure feeCapCents >= 0 && agent /= professional && agent /= client

    choice Accept : ContractId SupervisionMandate
      controller client
      do
        statusCid <- create MandateStatus with
          professional = professional; client = client; agent = agent
          matterHash = matterHash; expires = expires; reviewRecipients = reviewRecipients
        create SupervisionMandate with
           professional = professional; client = client; agent = agent
           matterHash = matterHash; allowed = allowed; feeCapCents = feeCapCents
           spentCents = 0; payees = payees; expires = expires; statusCid = statusCid

-- Stable lifetime/recipient control. Fee updates retain this contract ID.
template MandateStatus
  with
    professional : Party
    client : Party
    agent : Party
    matterHash : Text
    expires : Time
    reviewRecipients : [Party]
  where
    signatory professional, client
    observer agent
    ensure agent /= professional && agent /= client

checkLiveStatus : ContractId MandateStatus -> Party -> Party -> Party -> Text -> Update MandateStatus
checkLiveStatus cid professional client agent matterHash = do
  status <- fetch cid
  assertMsg "Mismatched mandate status"
    (status.professional == professional && status.client == client
      && status.agent == agent && status.matterHash == matterHash)
  now <- getTime
  assertMsg "Mandate expired" (now < status.expires)
  pure status

-- Step 2: the live mandate. Signed by professional AND client.
-- The agent is only an observer and the controller of a few narrow choices.
template SupervisionMandate
  with
    professional : Party
    client       : Party
    agent        : Party
    matterHash   : Text
    allowed      : [ActionKind]
    feeCapCents  : Int
    spentCents   : Int
    payees       : [Party]
    expires      : Time
    statusCid    : ContractId MandateStatus
  where
    signatory professional, client
    observer agent
    ensure spentCents >= 0 && spentCents <= feeCapCents
      && agent /= professional && agent /= client

    -- The agent records output references; the professional party controls approval.
    nonconsuming choice ProduceDraft : ContractId AgentDraft
      with
        kind       : ActionKind
        inputHash  : Text   -- hash of the input documents
        outputHash : Text   -- hash of the AI output
        modelId    : Text   -- model name and version
      controller agent
      do
        _ <- checkLiveStatus statusCid professional client agent matterHash
        assertMsg "Action not in mandate" (kind `elem` allowed)
        create AgentDraft with
          professional = professional; client = client; agent = agent
          matterHash = matterHash; kind = kind; inputHash = inputHash
          outputHash = outputHash; modelId = modelId; statusCid = statusCid

    -- Record an approved fee under the cap. This does not transfer tokens.
    -- Consuming: the mandate is re-created with the new running total.
    choice PayFee : (ContractId SupervisionMandate, ContractId FeePayment)
      with
        payee       : Party
        amountCents : Int
        memoHash    : Text
      controller agent
      do
        _ <- checkLiveStatus statusCid professional client agent matterHash
        assertMsg "Payee not approved" (payee `elem` payees)
        assertMsg "Amount must be positive" (amountCents > 0)
        assertMsg "Over fee cap" (spentCents + amountCents <= feeCapCents)
        m <- create this with spentCents = spentCents + amountCents
        p <- create FeePayment with
          professional = professional; client = client; agent = agent
          matterHash = matterHash; payee = payee; amountCents = amountCents
          memoHash = memoHash
        pure (m, p)

    -- Either the professional or the client can end the mandate at any time.
    choice RevokeByProfessional : ()
      controller professional
      do archive statusCid

    choice RevokeByClient : ()
      controller client
      do archive statusCid

-- A draft record. Approval/rejection consumes it; external tools are not gated here.
template AgentDraft
  with
    professional : Party
    client       : Party
    agent        : Party
    matterHash   : Text
    kind         : ActionKind
    inputHash    : Text
    outputHash   : Text
    modelId      : Text
    statusCid    : ContractId MandateStatus
  where
    signatory professional, client
    observer agent

    -- The professional party controls approval; this does not authenticate a human.
    choice Approve : ContractId ReviewedWork
      with
        citationsChecked : Bool
        reviewNoteHash   : Text
        discloseTo       : [Party]  -- e.g. the court. Sees the receipt, not the content
      controller professional
      do
        status <- checkLiveStatus statusCid professional client agent matterHash
        assertMsg "Receipt recipient not approved"
          (all (\p -> p `elem` status.reviewRecipients) discloseTo)
        assertMsg "Citations must be checked before approval" citationsChecked
        reviewedAt <- getTime
        create ReviewedWork with
          professional = professional; client = client; agent = agent
          matterHash = matterHash; kind = kind; inputHash = inputHash
          outputHash = outputHash; modelId = modelId
          citationsChecked = citationsChecked; reviewNoteHash = reviewNoteHash
          discloseTo = discloseTo; reviewedAt = reviewedAt

    choice Reject : ()
      with reasonHash : Text
      controller professional
      do pure ()

-- Review attestation with caller-supplied document/model references.
-- A verifier must check trusted identities, document binding and creation provenance.
template ReviewedWork
  with
    professional     : Party
    client           : Party
    agent            : Party
    matterHash       : Text
    kind             : ActionKind
    inputHash        : Text
    outputHash       : Text
    modelId          : Text
    citationsChecked : Bool
    reviewNoteHash   : Text
    discloseTo       : [Party]
    reviewedAt       : Time
  where
    signatory professional, client
    observer agent, discloseTo
    ensure citationsChecked && agent /= professional && agent /= client

-- Metadata-only fee record. Settlement (e.g. a CIP-56 token transfer)
-- would hang off this in a real build; out of scope for the sketch.
template FeePayment
  with
    professional : Party
    client       : Party
    agent        : Party
    matterHash   : Text
    payee        : Party
    amountCents  : Int
    memoHash     : Text
  where
    signatory professional, client
    observer agent, payee
